#!/bin/sh
# aeiou-launch: start one `aeiou run`, `aeiou datagen`, or `aeiou-datagen` rank per host over ssh (the `pdsh`/ssh
# loop of `NAPKIN_MATH.md` §8.A), rank 0 first, with --ranks, --rank, and --coordinator appended.
#
#   aeiou-launch [-p PORT] [-f FILE] [HOST...] -- aeiou run|datagen|aeiou-datagen ABSTRACT --root DIR [ARGS...]
#
# The hosts are the command line's, then the file's (one or more per line, `#` comments); a
# name may carry one pdsh-style bracket range, `n[1-4]`, `n[01-10]` (zero-padded to the width
# written), `n[1,3,5-7]`, `n[1-4]-ib` (the shell's own `n{1..4}` works too, expanded before this
# script runs). The i-th host is rank i; HOST0:PORT (default 7311) is the coordinator address
# rank 0 listens on and every rank connects to, so HOST0 must be reachable from the others
# under that name. Each host's output is prefixed with its rank, a whole line at a time; the
# exit status is non-zero if any rank's is. Ctrl-C (SIGINT) or SIGTERM here is sent to every
# rank's command over its ssh session's stdin (below); then the ranks are waited for and the
# exit status is 130 or 143. AEIOU_RSH replaces `ssh` (it is called as
# `$AEIOU_RSH HOST COMMAND`, and must pass its stdin to COMMAND).
#
# Usage errors are printed in the suite's frame (runner/REFERENCE.md §15): the command, what is
# missing, the usage line, the pointer to the help; exit status 2.
set -u
# no pathname expansion: the unquoted expansions below split host names and ranges into words,
# and `n[1-4]` is a glob that would match a file `n1` in the working directory
set -f
USAGE="Usage: aeiou-launch [OPTIONS] [HOSTS]... -- aeiou run|datagen|aeiou-datagen <ARGS>..."
usage_error() {
    printf '%s\n\n%s\n\nFor more information, try '"'"'aeiou-launch --help'"'"'.\n' "aeiou-launch: $1" "$USAGE" >&2
    exit 2
}
if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
    cat <<EOT
Start one \`aeiou run\`, \`aeiou datagen\`, or \`aeiou-datagen\` rank per host over ssh, rank 0 first, with
--ranks, --rank, and --coordinator appended

$USAGE

Arguments:
  [HOSTS]...  The hosts, one rank each, the command line's then the file's; the first is rank 0 and the
              coordinator (HOST0:PORT), so it must be reachable from the others under that name. A name may
              carry one bracket range as pdsh writes it: n[1-4], n[01-10] (zero-padded), n[1,3,5-7], n[1-4]-ib
  <ARGS>...   After --: the \`aeiou run\`, \`aeiou datagen\`, or \`aeiou-datagen\` command line every host runs
              (--ranks, --rank, --coordinator are appended)

Options:
  -p <PORT>   The coordinator's port [default: 7311]
  -f <FILE>   Hosts from a file too, one or more per line, # comments, bracket ranges as above
  -h, --help  Print help

Each host's output is prefixed with its rank; the exit status is non-zero if any rank's is. Ctrl-C (SIGINT) or
SIGTERM is sent to every rank, which are then waited for; the exit status is 130 or 143. AEIOU_RSH replaces
\`ssh\` (it is called as \$AEIOU_RSH HOST COMMAND and must pass its stdin to COMMAND, which is how the signal
travels).
EOT
    exit 0
fi

# append the hosts of one name to $hosts, one per line: `pre[spec]post` with spec a comma
# list of n or lo-hi (in this shell, not a subshell, so a usage error exits the script)
expand_host() {
    case $1 in
    *\[*\]*) ;;
    *) hosts="$hosts
$1"; return ;;
    esac
    name=$1
    pre=${name%%\[*}
    rest=${name#*\[}
    spec=${rest%%\]*}
    post=${rest#*\]}
    oldifs=$IFS
    IFS=,
    set -- $spec
    IFS=$oldifs
    [ $# -gt 0 ] || usage_error "empty bracket range in host '$name'"
    for item do
        case $item in
        *-*) lo=${item%%-*}; hi=${item#*-} ;;
        *) lo=$item; hi=$item ;;
        esac
        case "$lo$hi" in
        "" | *[!0-9]*) usage_error "bad bracket range '$item' in host '$name': want N or LO-HI, digits only" ;;
        esac
        width=${#lo}
        # decimal, whatever the leading zeros (the shell would read 08 as octal)
        n=${lo#"${lo%%[!0]*}"}; n=${n:-0}
        last=${hi#"${hi%%[!0]*}"}; last=${last:-0}
        [ "$n" -le "$last" ] || usage_error "bad bracket range '$item' in host '$name': $lo is above $hi"
        while [ "$n" -le "$last" ]; do
            hosts="$hosts
$(printf "%s%0${width}d%s" "$pre" "$n" "$post")"
            n=$((n + 1))
        done
    done
}

port=7311
hostfile=
hosts=
while [ $# -gt 0 ]; do
    case $1 in
    --) break ;;
    -p)
        [ $# -ge 2 ] || usage_error "a value is required for '-p <PORT>' but none was supplied"
        port=$2
        shift 2
        continue
        ;;
    -f)
        [ $# -ge 2 ] || usage_error "a value is required for '-f <FILE>' but none was supplied"
        hostfile=$2
        shift 2
        continue
        ;;
    -*) usage_error "unexpected argument '$1' found" ;;
    *) expand_host "$1" ;;
    esac
    shift
done
if [ -n "$hostfile" ]; then
    [ -r "$hostfile" ] || usage_error "cannot read the host file '$hostfile'"
    while IFS= read -r line || [ -n "$line" ]; do
        line=${line%%#*}
        for w in $line; do
            expand_host "$w"
        done
    done < "$hostfile"
fi
missing=
if [ -z "$(printf '%s' "$hosts" | tr -d '\n')" ]; then
    missing="  [HOSTS]...  the hosts (on the command line or in -f FILE), one rank each; the first is rank 0 and the coordinator"
fi
if [ $# -lt 2 ]; then
    missing="$missing${missing:+
}  <ARGS>...   after --: the \`aeiou run\` or \`aeiou datagen\` command line every host runs"
fi
if [ -n "$missing" ]; then
    usage_error "the following required arguments were not provided:
$missing"
fi
shift
# The remote command: every argument single-quoted for the remote shell, behind a watcher that
# turns each line arriving on the session's stdin, INT or TERM, into that signal for the
# command, which `exec` leaves at the remote shell's pid. A command run over ssh without a
# tty gets no signal when the session ends, and ssh started here ignores SIGINT as every
# background job of a script does, so Ctrl-C reaches the ranks this way, over plain ssh. The
# command's stdin is /dev/null; an EOF with no line (the command ended, or ssh went away)
# ends the watcher and signals nothing.
cmd='exec 3<&0 </dev/null; { while read -r s <&3; do case $s in INT|TERM) kill -s $s $$ ;; esac; done; } >/dev/null 2>&1 & exec 3<&-'
for a in "$@"; do
    q=$(printf '%s' "$a" | sed "s/'/'\\\\''/g")
    cmd="$cmd '$q'"
done
set -- $hosts
ranks=$#
host0=$1
rsh=${AEIOU_RSH:-ssh}
tmp=$(mktemp -d) || exit 1
# A rank's ssh reads its stdin from a FIFO held open by a holder, which writes INT on SIGUSR1
# and TERM on SIGUSR2, a line each time (a second Ctrl-C is a second SIGINT for the command,
# which then exits at once), ends on SIGHUP (an EOF for the watcher), and ends by itself once
# this script is gone. The holder, ssh, and the prefixing loop ignore SIGTERM (and, as
# background jobs, SIGINT), so a signal sent to the whole process group reaches the ranks
# through this script alone.
holder="trap '' PIPE TERM; trap 'echo INT' USR1; trap 'echo TERM' USR2; trap 'kill -s KILL \$p 2>/dev/null; exit 0' HUP
p=; while kill -0 $$ 2>/dev/null; do kill -0 \"\$p\" 2>/dev/null || { sleep 60 >/dev/null & p=\$!; }; wait \$p; done; kill -s KILL \$p 2>/dev/null"
stopping=
holders=
stop() {
    [ -n "$stopping" ] || echo "aeiou-launch: SIG$1: stopping every rank" >&2
    stopping=$1
    case $1 in INT) u=USR1 ;; *) u=USR2 ;; esac
    for hp in $holders; do
        kill -s $u "$hp" 2>/dev/null
    done
}
trap 'stop INT' INT
trap 'stop TERM' TERM
rank=0
pids=
for h in "$@"; do
    [ -z "$stopping" ] || break
    mkfifo "$tmp/in$rank" || exit 1
    sh -c "$holder" > "$tmp/in$rank" &
    holders="$holders $!"
    # each line whole and prefixed as it arrives (`read` takes a pipe byte by byte, and each
    # printf is one write): a block-buffered filter splices the ranks' lines into each other
    # in a file or a pipe
    (
        trap '' TERM
        $rsh "$h" "$cmd --ranks $ranks --rank $rank --coordinator $host0:$port" < "$tmp/in$rank" 2>&1
        echo $? > "$tmp/$rank"
    ) | {
        trap '' TERM
        while IFS= read -r line || [ -n "$line" ]; do
            printf '[%s %s] %s\n' "$rank" "$h" "$line"
        done
    } &
    pids="$pids $!"
    if [ $rank -eq 0 ]; then
        sleep 1
    fi
    rank=$((rank + 1))
done
started=$rank
# a trapped signal ends a `wait` early: wait again while the rank's pipeline is there
for p in $pids; do
    while :; do
        wait "$p" && break
        kill -0 "$p" 2>/dev/null || break
    done
done
for hp in $holders; do
    kill -s HUP "$hp" 2>/dev/null
done
status=0
rank=0
for h in "$@"; do
    if [ $rank -ge $started ]; then
        echo "aeiou-launch: rank $rank ($h) was not started" >&2
        status=1
    else
        s=$(cat "$tmp/$rank" 2>/dev/null || echo 1)
        if [ "$s" != 0 ]; then
            echo "aeiou-launch: rank $rank ($h) exited with status $s" >&2
            status=1
        fi
    fi
    rank=$((rank + 1))
done
rm -rf "$tmp"
case $stopping in
INT) exit 130 ;;
TERM) exit 143 ;;
esac
exit $status
