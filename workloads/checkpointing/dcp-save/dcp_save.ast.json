      "pattern": "ckpt/step_{step:06}",
      "fields": {
        "step": "int"
      },
      "size": 0,
      "seed": 1592646274
    },
    "ckpt": {
      "pattern": "ckpt/step_{step:06}/__{rank}_0.distcp",
      "fields": {
        "step": "int",
        "rank": "int"
      },
      "size": "as_written",
      "seed": 1592646274
    },
