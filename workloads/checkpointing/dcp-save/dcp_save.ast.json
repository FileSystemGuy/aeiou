{
  "ast": "0.13",
  "name": "dcp_save",
  "doc": "Every rank writes its shard file per checkpoint step; rank 0 writes .metadata through a temp file and rename.",
  "params": {
    "steps": {
      "unit": "count",
      "kind": "int"
    },
    "step_time": {
      "unit": "ns",
      "doc": "compute per step: the model's on its accelerator",
      "kind": "int"
    },
    "ckpt_every": {
      "unit": "count",
      "kind": "int"
    },
    "items": {
      "unit": "count",
      "doc": "write items per rank: the model's parameter table (about 900 for an 8B model under FSDP2)",
      "kind": "int"
    },
    "item_bytes": {
      "unit": "bytes",
      "doc": "per-item bytes on each rank, 1/G of each tensor: a case holds at the GPU counts it declares",
      "kind": "array",
      "items": "int"
    },
    "meta_bytes": {
      "unit": "bytes",
      "doc": ".metadata size, measured per job: the global plan's pickle, which grows with the items, ranks, and names (traced 2,602 bytes for 6 items on 2 ranks)",
      "kind": "int"
    },
    "hdr": {
      "default": 704,
      "unit": "bytes",
      "doc": "per item, before the storage: zip local headers, data.pkl, padding to 64 (traced 2026-10-01, torch 2.14)"
    },
    "trailer": {
      "default": 873,
      "unit": "bytes",
      "doc": "per item, after the storage: version, byteorder, central directory, EOCD (traced 2026-10-01); less the storage's length mod 64, since the record after it is aligned"
    },
    "buf": {
      "default": {
        "from": "st_blksize",
        "of": "ckpt",
        "fallback": 1048576
      },
      "unit": "bytes",
      "doc": "Python BufferedWriter size = st_blksize of the shard file; an item above it is written directly, one at or below it is coalesced with its header and trailer"
    },
    "xfer": {
      "default": {
        "from": "st_blksize",
        "of": "ckpt",
        "fallback": 1048576
      },
      "unit": "bytes",
      "doc": "the readback's BufferedReader request size"
    },
    "readback": {
      "default": false,
      "doc": "read each shard back on the writing node after the final barrier; off by default, the restore is the separate dcp_load run on other nodes (PROJECT_BRIEF.md §8)"
    }
  },
  "namespaces": {
