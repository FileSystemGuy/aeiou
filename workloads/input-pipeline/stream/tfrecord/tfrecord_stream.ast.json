{
  "ast": "0.10",
  "name": "tfrecord_stream",
  "doc": "tf.data over TFRecord shards: cycle shards streamed concurrently, positioned reads of the buffer size to EOF.",
  "params": {
    "batch": {
      "default": 256,
      "unit": "count",
      "doc": "[config] samples per step"
    },
    "samples_per_file": {
      "default": 1024,
      "unit": "count",
      "doc": "[config] samples per shard"
    },
    "cycle": {
      "default": 4,
      "unit": "count",
      "doc": "[config] interleave cycle_length: shards one GPU's pipeline streams concurrently"
    },
    "prefetch": {
      "default": 1,
      "unit": "count",
      "doc": "[config] shards finished ahead of the training loop, per cycle slot"
    },
    "steps": {
      "default": 500,
      "unit": "count"
    },
    "sync_every": {
      "default": 1,
      "unit": "count",
      "doc": "synchronous data parallel (DDP, FSDP): every step waits for the slowest GPU (DESIGN_REVIEW.md §3.71 point 4; 500, the brief's reference workload, until 2026-10-14)"
    },
    "step_time": {
      "default": 105000000,
      "unit": "ns",
      "doc": "[measure] GPU step time on the target accelerator"
    },
    "decode": {
      "default": 0,
      "unit": "ns",
      "doc": "[measure] decode compute per shard in the input pipeline; 0 = I/O bound"
    },
    "xfer": {
      "default": 262144,
      "unit": "bytes",
      "doc": "[verify] the reader library's read buffer (TFRecord)"
    },
    "samples": {
      "default": 1281167,
      "unit": "count",
      "doc": "[config] corpus size; sized to the dataset rule (PROJECT_BRIEF.md §5)"
    },
    "sample_median": {
      "default": 112640,
      "unit": "bytes",
      "doc": "[measure] corpus"
    }
  },
  "datasets": {
    "shards": {
      "pattern": "train/shard-{id:05}.tfrecord",
      "layout": "compound",
      "access": "stream",
      "count": {
        "param": "samples"
      },
      "size": {
        "lognormal": {
          "median": {
            "param": "sample_median"
          },
          "sigma": 0.45
        }
      },
      "seed": 1592646288,
      "samples_per_file": {
        "param": "samples_per_file"
      },
      "format": {
        "class": "tfrecord",
        "reader": "tf.data.TFRecordDataset",
        "framing": {
          "columns": [
            {
              "row_header": 12,
              "row_footer": 4,
              "weight": 1.0
            }
          ],
          "writer": {}
        }
      }
    }
  },
  "actors": {
    "gpu": {
      "body": [
        {
          "loader": {
            "name": "shards",
            "index": "b",
            "workers": {
              "param": "cycle"
            },
            "prefetch": {
              "param": "prefetch"
            },
            "batches": {
              "ceil_div": [
                {
                  "mul": [
                    {
                      "param": "steps"
                    },
                    {
                      "param": "batch"
                    }
                  ]
                },
                {
                  "param": "samples_per_file"
                }
              ]
            },
            "ordered": true,
            "body": [
              {
                "let": {
                  "name": "s",
                  "value": {
                    "consume": "shards"
                  }
                }
              },
              {
                "open": {
                  "file": {
                    "ref": "s"
                  },
                  "flags": [
                    "RDONLY"
                  ]
                }
              },
              {
                "read": {
                  "file": {
                    "ref": "s"
                  },
                  "len": {
                    "param": "xfer"
                  },
                  "offset": 0,
                  "repeat": "until_eof"
                }
              },
              {
                "close": {
                  "file": {
                    "ref": "s"
                  }
                }
              },
              {
                "compute": {
                  "ns": {
                    "param": "decode"
                  }
                }
              }
            ]
          }
        },
        {
          "phase": {
            "name": "train",
            "body": [
              {
                "loop": {
                  "index": "step",
                  "to": {
                    "param": "steps"
                  },
                  "body": [
                    {
                      "loop": {
                        "index": "k",
                        "to": {
                          "sub": [
                            {
                              "ceil_div": [
                                {
                                  "mul": [
                                    {
                                      "add": [
                                        {
                                          "index": "step"
                                        },
                                        1
                                      ]
                                    },
                                    {
                                      "param": "batch"
                                    }
                                  ]
                                },
                                {
                                  "param": "samples_per_file"
                                }
                              ]
                            },
                            {
                              "ceil_div": [
                                {
                                  "mul": [
                                    {
                                      "index": "step"
                                    },
                                    {
                                      "param": "batch"
                                    }
                                  ]
                                },
                                {
                                  "param": "samples_per_file"
                                }
                              ]
                            }
                          ]
                        },
                        "body": [
                          {
                            "take": {
                              "channel": "shards"
                            }
                          }
                        ]
                      }
                    },
                    {
                      "compute": {
                        "ns": {
                          "param": "step_time"
                        }
                      }
                    },
                    {
                      "cond": {
                        "if": {
                          "eq": [
                            {
                              "mod": [
                                {
                                  "index": "step"
                                },
                                {
                                  "param": "sync_every"
                                }
                              ]
                            },
                            0
                          ]
                        },
                        "then": [
                          {
                            "barrier": {
                              "scope": "global"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  },
  "provenance": {
    "generator": {
      "script": "tfrecord_stream.py",
      "sha256": "2ee33f27457cc6cc108e4afb934199a004f4e3aafd08eddd2fb37854b38b068e",
      "builder_version": "0.1.0",
      "git": "4990966ecf1c-dirty"
    },
    "python": "3.12.13",
    "ast_sha256": "22929c8b95c0ff0bc17358dcfd3a8d0c8fdae07a4b23b220b4e57f4abed38426"
  }
}
