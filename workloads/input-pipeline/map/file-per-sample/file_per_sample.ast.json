{
  "ast": "0.12",
  "name": "file_per_sample",
  "doc": "PyTorch DataLoader over an ImageFolder-style corpus; W workers, B files per batch, in-order delivery.",
  "params": {
    "batch": {
      "unit": "count",
      "doc": "samples per step: the model's on its accelerator, whose memory sets it",
      "kind": "int"
    },
    "workers": {
      "unit": "count",
      "doc": "DataLoader worker processes per GPU: the job's",
      "kind": "int"
    },
    "prefetch": {
      "unit": "count",
      "doc": "batches each worker keeps ahead (prefetch_factor): the job's",
      "kind": "int"
    },
    "steps": {
      "unit": "count",
      "doc": "steps of the run: the job's",
      "kind": "int"
    },
    "sync_every": {
      "default": 1,
      "unit": "count",
      "doc": "synchronous data parallel (DDP, FSDP): every step waits for the slowest GPU (DESIGN_REVIEW.md §3.71 point 4; 500, the brief's reference workload, until 2026-10-14)"
    },
    "step_time": {
      "unit": "ns",
      "doc": "compute per step: the model's on its accelerator",
      "kind": "int"
    },
    "hdr_read": {
      "default": {
        "from": "st_blksize",
        "of": "train",
        "fallback": 1048576
      },
      "unit": "bytes",
      "doc": "Python BufferedReader request = st_blksize; 1 MiB on NFS with rsize 1 MiB (traced 2026-10-01)"
    },
    "walk": {
      "default": true,
      "doc": "the startup directory walk, as ImageFolder does it in every process (ABSTRACTS.md §9.8); on by default since 2026-10-02 (`enumerate` until 2026-10-13)"
    },
    "inventory": {
      "default": false,
      "doc": "the startup read of the corpus's inventory, every process, in place of the walk at scale (DESIGN_REVIEW.md §3.73)"
    },
    "inv_entry": {
      "default": 24,
      "unit": "bytes",
      "doc": "[measure] inventory bytes per file: the name below the root (`00000/img_000000000.jpg`) and a newline"
    },
    "inv_read": {
      "default": {
        "from": "st_blksize",
        "of": "train",
        "fallback": 1048576
      },
      "unit": "bytes",
      "doc": "[measure] the inventory reader's request; Python's BufferedReader asks st_blksize"
    },
    "samples": {
      "unit": "count",
      "doc": "corpus size: the submission's, sized to the dataset rule (PROJECT_BRIEF.md §5)",
      "scale": true,
      "kind": "int"
    },
    "files_per_directory": {
      "default": 1300,
      "unit": "count",
      "doc": "[config] files a directory holds, {id div files_per_directory} (contract 0.10); 1,300 is ImageNet-1k's most images in a class, as kit/mkcorpus.py writes them"
    },
    "sample_median": {
      "unit": "bytes",
      "doc": "median sample file size: the job's corpus",
      "kind": "int"
    }
  },
  "datasets": {
    "train": {
      "pattern": "train/{id div files_per_directory:05}/img_{id:09}.jpg",
      "layout": "whole",
      "access": "map",
      "count": {
        "param": "samples"
      },
      "size": {
        "lognormal": {
          "median": {
            "param": "sample_median"
          },
          "sigma": 0.45
        }
      },
      "seed": 1592646266,
      "inventory": {
        "name": "inventory.txt",
        "entry": {
          "param": "inv_entry"
        }
      }
    }
  },
  "actors": {
    "gpu": {
      "body": [
        {
          "cond": {
            "if": {
              "param": "walk"
            },
            "then": [
              {
                "phase": {
                  "name": "walk",
                  "body": [
                    {
                      "loop": {
                        "index": "d",
                        "to": {
                          "dirs": "train"
                        },
                        "body": [
                          {
                            "let": {
                              "name": "dh",
                              "value": {
                                "dir": {
                                  "dataset": "train",
                                  "id": {
                                    "index": "d"
                                  }
                                }
                              }
                            }
                          },
                          {
                            "stat": {
                              "file": {
                                "ref": "dh"
                              }
                            }
                          },
                          {
                            "open": {
                              "file": {
                                "ref": "dh"
                              },
                              "flags": [
                                "RDONLY",
                                "CLOEXEC",
                                "DIRECTORY"
                              ]
                            }
                          },
                          {
                            "fstat": {
                              "file": {
                                "ref": "dh"
                              }
                            }
                          },
                          {
                            "readdir": {
                              "dir": {
                                "ref": "dh"
                              },
                              "repeat": "until_end"
                            }
                          },
                          {
                            "close": {
                              "file": {
                                "ref": "dh"
                              }
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "cond": {
            "if": {
              "param": "inventory"
            },
            "then": [
              {
                "phase": {
                  "name": "inventory",
                  "body": [
                    {
                      "let": {
                        "name": "inv",
                        "value": {
                          "inventory": "train"
                        }
                      }
                    },
                    {
                      "open": {
                        "file": {
                          "ref": "inv"
                        },
                        "flags": [
                          "RDONLY",
                          "CLOEXEC"
                        ]
                      }
                    },
                    {
                      "fstat": {
                        "file": {
                          "ref": "inv"
                        }
                      }
                    },
                    {
                      "ioctl": {
                        "file": {
                          "ref": "inv"
                        },
                        "request": "TCGETS",
                        "expect": [
                          "ENOTTY"
                        ]
                      }
                    },
                    {
                      "lseek": {
                        "file": {
                          "ref": "inv"
                        },
                        "offset": 0,
                        "whence": "CUR"
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "inv"
                        },
                        "len": {
                          "param": "inv_read"
                        },
                        "repeat": "until_eof"
                      }
                    },
                    {
                      "close": {
                        "file": {
                          "ref": "inv"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "loader": {
            "name": "batches",
            "index": "b",
            "workers": {
              "param": "workers"
            },
            "prefetch": {
              "param": "prefetch"
            },
            "batches": {
              "param": "steps"
            },
            "ordered": true,
            "body": [
              {
                "loop": {
                  "index": "j",
                  "to": {
                    "param": "batch"
                  },
                  "body": [
                    {
                      "let": {
                        "name": "f",
                        "value": {
                          "consume": "train"
                        }
                      }
                    },
                    {
                      "open": {
                        "file": {
                          "ref": "f"
                        },
                        "flags": [
                          "RDONLY",
                          "CLOEXEC"
                        ]
                      }
                    },
                    {
                      "fstat": {
                        "file": {
                          "ref": "f"
                        }
                      }
                    },
                    {
                      "ioctl": {
                        "file": {
                          "ref": "f"
                        },
                        "request": "TCGETS",
                        "expect": [
                          "ENOTTY"
                        ]
                      }
                    },
                    {
                      "lseek": {
                        "file": {
                          "ref": "f"
                        },
                        "offset": 0,
                        "whence": "CUR"
                      }
                    },
                    {
                      "lseek": {
                        "file": {
                          "ref": "f"
                        },
                        "offset": 0,
                        "whence": "SET"
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": {
                          "param": "hdr_read"
                        },
                        "repeat": "until_eof"
                      }
                    },
                    {
                      "close": {
                        "file": {
                          "ref": "f"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "phase": {
            "name": "train",
            "body": [
              {
                "loop": {
                  "index": "step",
                  "to": {
                    "param": "steps"
                  },
                  "body": [
                    {
                      "take": {
                        "channel": "batches"
                      }
                    },
                    {
                      "compute": {
                        "ns": {
                          "param": "step_time"
                        }
                      }
                    },
                    {
                      "cond": {
                        "if": {
                          "eq": [
                            {
                              "mod": [
                                {
                                  "index": "step"
                                },
                                {
                                  "param": "sync_every"
                                }
                              ]
                            },
                            0
                          ]
                        },
                        "then": [
                          {
                            "barrier": {
                              "scope": "global"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  },
  "provenance": {
    "generator": {
      "script": "file_per_sample.py",
      "sha256": "436b924102e2f3b8e592bf6a9ae3b10d10ae9e2871d2b84478c29a5cb00ce49e",
      "builder_version": "0.2.1",
      "git": "eb1032107f99"
    },
    "python": "3.12.13",
    "built_twice_identical": true,
    "ast_sha256": "848f089b1e5be070a5f55094699b40b8696b3dcdd4b1374075fa5edc00ff8c70"
  }
}
