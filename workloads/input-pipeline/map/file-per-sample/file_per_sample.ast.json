{
  "ast": "0.10",
  "name": "file_per_sample",
  "doc": "PyTorch DataLoader over an ImageFolder-style corpus; W workers, B files per batch, in-order delivery.",
  "params": {
    "batch": {
      "default": 32,
      "unit": "count"
    },
    "workers": {
      "default": 8,
      "unit": "count"
    },
    "prefetch": {
      "default": 2,
      "unit": "count"
    },
    "steps": {
      "default": 500,
      "unit": "count"
    },
    "sync_every": {
      "default": 1,
      "unit": "count",
      "doc": "synchronous data parallel (DDP, FSDP): every step waits for the slowest GPU (DESIGN_REVIEW.md §3.71 point 4; 500, the brief's reference workload, until 2026-10-14)"
    },
    "step_time": {
      "default": 105000000,
      "unit": "ns",
      "doc": "[measure] GPU step time on the target accelerator"
    },
    "hdr_read": {
      "default": 1048576,
      "unit": "bytes",
      "doc": "Python BufferedReader request = st_blksize; 1 MiB on NFS with rsize 1 MiB (traced 2026-10-01)"
    },
    "walk": {
      "default": true,
      "doc": "the startup directory walk, as ImageFolder does it in every process (ABSTRACTS.md §9.8); on by default since 2026-10-02 (`enumerate` until 2026-10-13)"
    },
    "inventory": {
      "default": false,
      "doc": "the startup read of the corpus's inventory, every process, in place of the walk at scale (DESIGN_REVIEW.md §3.73)"
    },
    "inv_entry": {
      "default": 24,
      "unit": "bytes",
      "doc": "[measure] inventory bytes per file: the name below the root (`00000/img_000000000.jpg`) and a newline"
    },
    "inv_read": {
      "default": 1048576,
      "unit": "bytes",
      "doc": "[measure] the inventory reader's request; Python's BufferedReader asks st_blksize"
    },
    "samples": {
      "default": 50000000,
      "unit": "count",
      "doc": "[config] corpus size; sized to the dataset rule (PROJECT_BRIEF.md §5)"
    },
    "files_per_directory": {
      "default": 1300,
      "unit": "count",
      "doc": "[config] files a directory holds, {id div files_per_directory} (contract 0.10); 1,300 is ImageNet-1k's most images in a class, as kit/mkcorpus.py writes them"
    }
  },
  "datasets": {
    "train": {
      "pattern": "train/{id div files_per_directory:05}/img_{id:09}.jpg",
      "layout": "whole",
      "access": "map",
      "count": {
        "param": "samples"
      },
      "size": {
        "lognormal": {
          "median": 112640,
          "sigma": 0.45
        }
      },
      "seed": 1592646266,
      "inventory": {
        "name": "inventory.txt",
        "entry": {
          "param": "inv_entry"
        }
      }
    }
  },
  "actors": {
    "gpu": {
      "body": [
        {
          "cond": {
            "if": {
              "param": "walk"
            },
            "then": [
              {
                "phase": {
                  "name": "walk",
                  "body": [
                    {
                      "loop": {
                        "index": "d",
                        "to": {
                          "dirs": "train"
                        },
                        "body": [
                          {
                            "let": {
                              "name": "dh",
                              "value": {
                                "dir": {
                                  "dataset": "train",
                                  "id": {
                                    "index": "d"
                                  }
                                }
                              }
                            }
                          },
                          {
                            "stat": {
                              "file": {
                                "ref": "dh"
                              }
                            }
                          },
                          {
                            "open": {
                              "file": {
                                "ref": "dh"
                              },
                              "flags": [
                                "RDONLY",
                                "CLOEXEC",
                                "DIRECTORY"
                              ]
                            }
                          },
                          {
                            "fstat": {
                              "file": {
                                "ref": "dh"
                              }
                            }
                          },
                          {
                            "readdir": {
                              "dir": {
                                "ref": "dh"
                              },
                              "repeat": "until_end"
                            }
                          },
                          {
                            "close": {
                              "file": {
                                "ref": "dh"
                              }
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "cond": {
            "if": {
              "param": "inventory"
            },
            "then": [
              {
                "phase": {
                  "name": "inventory",
                  "body": [
                    {
                      "let": {
                        "name": "inv",
                        "value": {
                          "inventory": "train"
                        }
                      }
                    },
                    {
                      "open": {
                        "file": {
                          "ref": "inv"
                        },
                        "flags": [
                          "RDONLY",
                          "CLOEXEC"
                        ]
                      }
                    },
                    {
                      "fstat": {
                        "file": {
                          "ref": "inv"
                        }
                      }
                    },
                    {
                      "ioctl": {
                        "file": {
                          "ref": "inv"
                        },
                        "request": "TCGETS",
                        "expect": [
                          "ENOTTY"
                        ]
                      }
                    },
                    {
                      "lseek": {
                        "file": {
                          "ref": "inv"
                        },
                        "offset": 0,
                        "whence": "CUR"
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "inv"
                        },
                        "len": {
                          "param": "inv_read"
                        },
                        "repeat": "until_eof"
                      }
                    },
                    {
                      "close": {
                        "file": {
                          "ref": "inv"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "loader": {
            "name": "batches",
            "index": "b",
            "workers": {
              "param": "workers"
            },
            "prefetch": {
              "param": "prefetch"
            },
            "batches": {
              "param": "steps"
            },
            "ordered": true,
            "body": [
              {
                "loop": {
                  "index": "j",
                  "to": {
                    "param": "batch"
                  },
                  "body": [
                    {
                      "let": {
                        "name": "f",
                        "value": {
                          "consume": "train"
                        }
                      }
                    },
                    {
                      "open": {
                        "file": {
                          "ref": "f"
                        },
                        "flags": [
                          "RDONLY",
                          "CLOEXEC"
                        ]
                      }
                    },
                    {
                      "fstat": {
                        "file": {
                          "ref": "f"
                        }
                      }
                    },
                    {
                      "ioctl": {
                        "file": {
                          "ref": "f"
                        },
                        "request": "TCGETS",
                        "expect": [
                          "ENOTTY"
                        ]
                      }
                    },
                    {
                      "lseek": {
                        "file": {
                          "ref": "f"
                        },
                        "offset": 0,
                        "whence": "CUR"
                      }
                    },
                    {
                      "lseek": {
                        "file": {
                          "ref": "f"
                        },
                        "offset": 0,
                        "whence": "SET"
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": {
                          "param": "hdr_read"
                        },
                        "repeat": "until_eof"
                      }
                    },
                    {
                      "close": {
                        "file": {
                          "ref": "f"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "phase": {
            "name": "train",
            "body": [
              {
                "loop": {
                  "index": "step",
                  "to": {
                    "param": "steps"
                  },
                  "body": [
                    {
                      "take": {
                        "channel": "batches"
                      }
                    },
                    {
                      "compute": {
                        "ns": {
                          "param": "step_time"
                        }
                      }
                    },
                    {
                      "cond": {
                        "if": {
                          "eq": [
                            {
                              "mod": [
                                {
                                  "index": "step"
                                },
                                {
                                  "param": "sync_every"
                                }
                              ]
                            },
                            0
                          ]
                        },
                        "then": [
                          {
                            "barrier": {
                              "scope": "global"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  },
  "provenance": {
    "generator": {
      "script": "file_per_sample.py",
      "sha256": "b133bf1b27d8ac86623338fc731c964450dffa7a1c7960bb1860db084ddc2641",
      "builder_version": "0.1.0",
      "git": "31e0b4543f2f-dirty"
    },
    "python": "3.12.13",
    "built_twice_identical": true,
    "ast_sha256": "45fbae4fbc75d23ecd452aefc73b727822cdde558b48c5616757b7f25c673a4e"
  }
}
