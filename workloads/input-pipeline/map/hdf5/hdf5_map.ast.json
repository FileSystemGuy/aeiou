{
  "ast": "0.11",
  "name": "hdf5_map",
  "doc": "DataLoader over HDF5 containers of fixed-size rows: open, metadata reads, one positioned row read, close per sample.",
  "params": {
    "batch": {
      "unit": "count",
      "doc": "samples per step: the model's on its accelerator, whose memory sets it",
      "kind": "int"
    },
    "workers": {
      "unit": "count",
      "doc": "DataLoader worker processes per GPU: the job's",
      "kind": "int"
    },
    "prefetch": {
      "unit": "count",
      "doc": "batches each worker keeps ahead (prefetch_factor): the job's",
      "kind": "int"
    },
    "steps": {
      "unit": "count",
      "doc": "steps of the run: the job's",
      "kind": "int"
    },
    "sync_every": {
      "default": 1,
      "unit": "count",
      "doc": "synchronous data parallel (DDP, FSDP): every step waits for the slowest GPU (DESIGN_REVIEW.md §3.71 point 4; 500, the brief's reference workload, until 2026-10-14)"
    },
    "step_time": {
      "unit": "ns",
      "doc": "compute per step: the model's on its accelerator",
      "kind": "int"
    },
    "samples_per_file": {
      "unit": "count",
      "doc": "samples per container: the job's corpus",
      "kind": "int"
    },
    "samples": {
      "unit": "count",
      "doc": "corpus size: the submission's, sized to the dataset rule (PROJECT_BRIEF.md §5)",
      "scale": true,
      "kind": "int"
    }
  },
  "datasets": {
    "train": {
      "pattern": "train/samples-{id:05}.h5",
      "layout": "compound",
      "access": "map",
      "count": {
        "param": "samples"
      },
      "size": {
        "const": 196608
      },
      "seed": 1592646289,
      "samples_per_file": {
        "param": "samples_per_file"
      },
      "format": {
        "class": "hdf5",
        "reader": "h5py",
        "version": "h5py 3.16.0, hdf5 2.0.0",
        "framing": {
          "file_header": 2048,
          "writer": {
            "dataset": "records",
            "shape": [
              256,
              256,
              3
            ],
            "dtype": "u1",
            "sieve": 65536
          }
        }
      }
    }
  },
  "actors": {
    "gpu": {
      "body": [
        {
          "loader": {
            "name": "batches",
            "index": "b",
            "workers": {
              "param": "workers"
            },
            "prefetch": {
              "param": "prefetch"
            },
            "batches": {
              "param": "steps"
            },
            "ordered": true,
            "body": [
              {
                "loop": {
                  "index": "j",
                  "to": {
                    "param": "batch"
                  },
                  "body": [
                    {
                      "let": {
                        "name": "s",
                        "value": {
                          "consume": "train"
                        }
                      }
                    },
                    {
                      "let": {
                        "name": "f",
                        "value": {
                          "file": {
                            "of": {
                              "ref": "s"
                            }
                          }
                        }
                      }
                    },
                    {
                      "open": {
                        "file": {
                          "ref": "f"
                        },
                        "flags": [
                          "RDONLY",
                          "CLOEXEC"
                        ]
                      }
                    },
                    {
                      "fstat": {
                        "file": {
                          "ref": "f"
                        }
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": 8,
                        "offset": 0
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": 48,
                        "offset": 0
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": 48,
                        "offset": 48
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": 512,
                        "offset": 96
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": 512,
                        "offset": 680
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": 544,
                        "offset": 136
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": 328,
                        "offset": 1072
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": 512,
                        "offset": 800
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": {
                          "size": {
                            "ref": "s"
                          }
                        },
                        "offset": {
                          "offset": {
                            "ref": "s"
                          }
                        }
                      }
                    },
                    {
                      "close": {
                        "file": {
                          "ref": "f"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "phase": {
            "name": "train",
            "body": [
              {
                "loop": {
                  "index": "step",
                  "to": {
                    "param": "steps"
                  },
                  "body": [
                    {
                      "take": {
                        "channel": "batches"
                      }
                    },
                    {
                      "compute": {
                        "ns": {
                          "param": "step_time"
                        }
                      }
                    },
                    {
                      "cond": {
                        "if": {
                          "eq": [
                            {
                              "mod": [
                                {
                                  "index": "step"
                                },
                                {
                                  "param": "sync_every"
                                }
                              ]
                            },
                            0
                          ]
                        },
                        "then": [
                          {
                            "barrier": {
                              "scope": "global"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  },
