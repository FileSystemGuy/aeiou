{
  "ast": "0.8",
  "name": "hdf5_map",
  "doc": "DataLoader over HDF5 containers of fixed-size rows: open, metadata reads, one positioned row read, close per sample.",
  "params": {
    "batch": {
      "default": 32,
      "unit": "count"
    },
    "workers": {
      "default": 8,
      "unit": "count"
    },
    "prefetch": {
      "default": 2,
      "unit": "count"
    },
    "steps": {
      "default": 500,
      "unit": "count"
    },
    "sync_every": {
      "default": 500,
      "unit": "count",
      "doc": "1 for DDP; 500 keeps the brief's reference workload"
    },
    "step_time": {
      "default": 105000000,
      "unit": "ns",
      "doc": "[measure] GPU step time on the target accelerator"
    },
    "per_file": {
      "default": 512,
      "unit": "count",
      "doc": "[config] samples per container (96 MiB each)"
    },
    "samples": {
      "default": 1000000,
      "unit": "count",
      "doc": "[config] corpus size; sized to the dataset rule (PROJECT_BRIEF.md §5)"
    }
  },
  "datasets": {
    "train": {
      "pattern": "train/samples-{id:05}.h5",
      "layout": "compound",
      "access": "map",
      "count": {
        "param": "samples"
      },
      "size": {
        "const": 196608
      },
      "seed": 1592646289,
      "samples_per_file": {
        "param": "per_file"
      },
      "format": {
        "class": "hdf5",
        "reader": "h5py",
        "version": "h5py 3.16.0, hdf5 2.0.0",
        "framing": {
          "file_header": 2048,
          "writer": {
            "dataset": "records",
            "shape": [
              256,
              256,
              3
            ],
            "dtype": "u1",
            "sieve": 65536
          }
        }
      }
    }
  },
  "actors": {
    "gpu": {
      "body": [
        {
          "loader": {
            "name": "batches",
            "index": "b",
            "workers": {
              "param": "workers"
            },
            "prefetch": {
              "param": "prefetch"
            },
            "batches": {
              "param": "steps"
            },
            "ordered": true,
            "body": [
              {
                "loop": {
                  "index": "j",
                  "to": {
                    "param": "batch"
                  },
                  "body": [
                    {
                      "let": {
                        "name": "s",
                        "value": {
                          "consume": "train"
                        }
                      }
                    },
                    {
                      "let": {
                        "name": "f",
                        "value": {
                          "file": {
                            "of": {
                              "ref": "s"
                            }
                          }
                        }
                      }
                    },
                    {
                      "open": {
                        "file": {
                          "ref": "f"
                        },
                        "flags": [
                          "RDONLY",
                          "CLOEXEC"
                        ]
                      }
                    },
                    {
                      "fstat": {
                        "file": {
                          "ref": "f"
                        }
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": 8,
                        "offset": 0
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": 48,
                        "offset": 0
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": 48,
                        "offset": 48
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": 512,
                        "offset": 96
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": 512,
                        "offset": 680
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": 544,
                        "offset": 136
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": 328,
                        "offset": 1072
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": 512,
                        "offset": 800
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": {
                          "size": {
                            "ref": "s"
                          }
                        },
                        "offset": {
                          "offset": {
                            "ref": "s"
                          }
                        }
                      }
                    },
                    {
                      "close": {
                        "file": {
                          "ref": "f"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "phase": {
            "name": "train",
            "body": [
              {
                "loop": {
                  "index": "step",
                  "to": {
                    "param": "steps"
                  },
                  "body": [
                    {
                      "take": {
                        "channel": "batches"
                      }
                    },
                    {
                      "compute": {
                        "ns": {
                          "param": "step_time"
                        }
                      }
                    },
                    {
                      "cond": {
                        "if": {
                          "eq": [
                            {
                              "mod": [
                                {
                                  "index": "step"
                                },
                                {
                                  "param": "sync_every"
                                }
                              ]
                            },
                            0
                          ]
                        },
                        "then": [
                          {
                            "barrier": {
                              "scope": "global"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  },
