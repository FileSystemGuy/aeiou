{
  "ast": "0.9",
  "name": "npy_per_sample",
  "doc": "np.load of one ~140 MiB .npz per sample through a PyTorch DataLoader; magic, zip tail, then the archive front to back.",
  "params": {
    "batch": {
      "default": 7,
      "unit": "count"
    },
    "workers": {
      "default": 4,
      "unit": "count"
    },
    "prefetch": {
      "default": 2,
      "unit": "count"
    },
    "steps": {
      "default": 500,
      "unit": "count"
    },
    "sync_every": {
      "default": 500,
      "unit": "count"
    },
    "step_time": {
      "default": 323000000,
      "unit": "ns",
      "doc": "[measure]"
    },
    "hdr_read": {
      "default": 1048576,
      "unit": "bytes",
      "doc": "Python BufferedReader request = st_blksize; 1 MiB on NFS with rsize 1 MiB (traced 2026-10-01)"
    },
    "xfer": {
      "default": 1048576,
      "unit": "bytes",
      "doc": "buffer fill under the member read: the same BufferedReader, so st_blksize (traced 2026-10-01)"
    },
    "np_chunk": {
      "default": 262144,
      "unit": "bytes",
      "doc": "NumPy's read chunk from a zip member (numpy.lib.format BUFFER_SIZE); one tell per chunk"
    },
    "cd_len": {
      "default": 102,
      "unit": "bytes",
      "doc": "central directory bytes: two entries, \"x.npy\" and \"y.npy\" (traced 2026-10-01)"
    },
    "framing": {
      "default": 498,
      "unit": "bytes",
      "doc": "archive bytes that are not x's data: x's local header and npy header (183), the y member (191), central directory (102), EOCD (22); np.savez(x=, y=[0]) (traced 2026-10-01)"
    },
    "walk": {
      "default": true,
      "doc": "the startup listing: the training script's glob over the corpus, one scandir per directory (traced 2026-10-02); on by default (`enumerate` until 2026-10-13)"
    },
    "inventory": {
      "default": false,
      "doc": "the startup read of the corpus's inventory, every process, in place of the glob at scale (DESIGN_REVIEW.md §3.73)"
    },
    "inv_entry": {
      "default": 27,
      "unit": "bytes",
      "doc": "[measure] inventory bytes per file: the name below the root (`00000/sample_000000000.npz`) and a newline"
    },
    "inv_read": {
      "default": 1048576,
      "unit": "bytes",
      "doc": "[measure] the inventory reader's request; Python's BufferedReader asks st_blksize"
    },
    "files": {
      "default": 50000,
      "unit": "count",
      "doc": "[config] corpus size; sized to the dataset rule (PROJECT_BRIEF.md §5)"
    },
    "sample_mean": {
