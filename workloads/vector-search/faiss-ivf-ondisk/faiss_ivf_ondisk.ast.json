      "doc": "search calls",
      "kind": "int"
    },
    "batch": {
      "unit": "count",
      "doc": "[config] queries per slice per call (the call's batch is threads * batch)",
      "kind": "int"
    },
    "nprobe": {
      "unit": "count",
      "doc": "[config] lists probed per query",
      "kind": "int"
    },
    "prefetch_nthread": {
      "default": 32,
      "unit": "count",
      "doc": "the library's prefetch threads per slice at most (`OnDiskInvertedLists::prefetch_nthread`, traced)"
