    "list_pop": {
      "doc": "list popularity over the queries (params.py fits it; 0.20-0.25 on SIFT1M with its own query set)",
      "kind": "dist"
    },
    "distance": {
      "unit": "ns",
      "doc": "[measure] scan time per query (no trace measures it: the traced example takes 0.4 ms, the value the defaults held, not fitted)",
      "kind": "int"
    },
    "lists": {
      "unit": "count",
      "doc": "[config] inverted lists",
      "kind": "int"
    },
    "list_bytes": {
      "doc": "[config] codes + ids of one list: vectors per list * (code size + 8), a distribution over the lists (params.py fits it); its max no larger than the slot",
      "kind": "dist"
    },
    "code_size": {
      "unit": "bytes",
      "doc": "[config] bytes of one vector's code (32 for PQ32); its id is 8 more",
      "kind": "int"
    },
    "index_bytes": {
      "unit": "bytes",
      "doc": "[config] the index file: centroids (lists * dimension * 4 bytes), codebooks, 16 bytes per list",
      "kind": "int"
    },
    "index_reads": {
      "unit": "bytes",
      "doc": "[config] read lengths on the index file: stdio fills 8,192 bytes, and reads the bulk of each large array (centroids, codebooks, list table) directly (params.py reads them from the trace)",
      "kind": "array",
      "items": "int"
    }
