  "ast": "0.13",
  "name": "faiss_ivf_ondisk",
  "doc": "Per search call and OpenMP slice, prefetch threads touch every inverted list the slice's queries probe; lists chosen by popularity.",
  "posix": "mmap",
  "params": {
    "threads": {
      "unit": "count",
      "doc": "[config] OpenMP threads: a search call of n queries runs min(threads, n) slices",
