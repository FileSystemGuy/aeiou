{
  "ast": "0.3",
  "name": "vdb_search_ivf",
  "doc": "Per query, nprobe concurrent reads of whole inverted lists chosen by Zipf popularity.",
  "params": {
    "threads": {
      "default": 32,
      "unit": "count"
    },
    "queries": {
      "default": 100000,
      "unit": "count"
    },
    "nprobe": {
      "default": 64,
      "unit": "count"
    },
    "list_pop": {
      "default": {
        "zipf": {
          "s": 0.8
        }
      },
      "doc": "list popularity [measure]"
    },
    "distance": {
      "default": 400000,
      "unit": "ns",
      "doc": "[measure]"
    },
    "lists": {
      "default": 1000000,
      "unit": "count",
      "doc": "[config] inverted lists"
    }
  },
  "datasets": {
    "lists": {
      "regions": {
        "file": "ivf/invlists.bin",
        "count": {
          "param": "lists"
        },
        "slot": 262144,
        "size": {
          "lognormal": {
            "median": 40960,
            "sigma": 0.9
          }
        },
        "seed": 1592646270
      }
    }
  },
  "actors": {
    "gpu": {
      "body": [
        {
          "parallel": {
            "index": "th",
            "width": {
              "param": "threads"
            },
            "body": [
              {
                "let": {
                  "name": "f",
                  "value": {
                    "file": {
                      "dataset": "lists",
                      "id": 0
                    }
                  }
                }
              },
              {
                "open": {
                  "file": {
                    "ref": "f"
                  },
                  "flags": [
                    "RDONLY"
                  ]
                }
              },
              {
                "loop": {
                  "index": "q",
                  "to": {
                    "param": "queries"
                  },
                  "body": [
                    {
                      "parallel": {
                        "index": "p",
                        "width": {
                          "param": "nprobe"
                        },
                        "body": [
                          {
                            "let": {
                              "name": "c",
                              "value": {
                                "pick": {
                                  "dataset": "lists",
                                  "dist": {
                                    "param": "list_pop"
                                  }
                                }
                              }
                            }
                          },
                          {
                            "read": {
                              "file": {
                                "ref": "f"
                              },
                              "len": {
                                "size": {
                                  "ref": "c"
                                }
                              },
                              "offset": {
                                "offset": {
                                  "ref": "c"
                                }
                              }
                            }
                          }
                        ]
                      }
                    },
                    {
                      "compute": {
                        "ns": {
                          "param": "distance"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "close": {
                  "file": {
                    "ref": "f"
                  }
                }
              }
            ]
          }
        }
      ]
    }
  },
  "provenance": {
    "generator": {
      "script": "vdb_search_ivf.py",
      "sha256": "e484d3d6730775c0ae4048c5f45c7d3450bb948d5b811f205447c706a65f0724",
      "builder_version": "0.1.0",
      "git": "32e33f8e9e9b"
    },
    "python": "3.12.13",
    "lock": {
      "file": "uv.lock",
      "sha256": "33cb12fe685c0477a2948b64e0a1b95787eeb66217ec71283d1aa47972cec724"
    },
    "built_twice_identical": true,
    "ast_sha256": "9d72a58e47fa81a9f6d07c4d8a9e66a9e70859b438417e67e7c7c8634346af5d"
  }
}
