                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": 512,
                        "offset": 800
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": {
                          "size": {
                            "ref": "s"
                          }
                        },
                        "offset": {
                          "offset": {
                            "ref": "s"
                          }
                        }
                      }
                    },
                    {
                      "close": {
                        "file": {
                          "ref": "f"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "phase": {
            "name": "train",
            "body": [
              {
                "loop": {
                  "index": "step",
                  "to": {
                    "param": "steps"
                  },
                  "body": [
                    {
                      "take": {
                        "channel": "batches"
                      }
                    },
                    {
                      "compute": {
                        "ns": {
                          "param": "step_time"
                        }
                      }
                    },
                    {
                      "cond": {
                        "if": {
                          "eq": [
                            {
                              "mod": [
                                {
                                  "index": "step"
                                },
                                {
                                  "param": "sync_every"
                                }
                              ]
                            },
                            0
                          ]
                        },
                        "then": [
                          {
                            "barrier": {
                              "scope": "global"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
