{
  "ast": "0.3",
  "name": "train_map_hdf5",
  "doc": "DataLoader over HDF5 containers of fixed-size rows: open, metadata reads, one positioned row read, close per sample.",
  "params": {
    "batch": {
      "default": 32,
      "unit": "count"
    },
    "workers": {
      "default": 8,
      "unit": "count"
    },
    "prefetch": {
      "default": 2,
      "unit": "count"
    },
    "steps": {
      "default": 500,
      "unit": "count"
    },
    "sync_every": {
      "default": 500,
      "unit": "count",
      "doc": "1 for DDP; 500 keeps the brief's reference workload"
    },
    "step_time": {
      "default": 105000000,
      "unit": "ns",
      "doc": "[measure] GPU step time on the target accelerator"
    },
    "per_file": {
      "default": 512,
      "unit": "count",
      "doc": "[config] samples per container (96 MiB each)"
    },
    "samples": {
      "default": 1000000,
      "unit": "count",
      "doc": "[config] corpus size; sized to the dataset rule (PROJECT_BRIEF.md §5)"
    }
  },
  "datasets": {
    "train": {
      "files": {
        "pattern": "train/samples-{id:05}.h5",
        "count": {
          "param": "samples"
        },
        "size": {
          "const": 196608
        },
        "seed": 1592646289,
        "access": "map",
        "samples_per_file": {
          "param": "per_file"
        },
        "format": {
          "class": "hdf5",
          "reader": "h5py",
          "version": "h5py 3.16.0, hdf5 2.0.0",
          "layout": {
            "file_header": 2048,
            "writer": {
              "dataset": "records",
              "shape": [
                256,
                256,
                3
              ],
              "dtype": "u1",
              "sieve": 65536
            }
          }
        }
      }
    }
  },
  "actors": {
    "gpu": {
      "body": [
        {
          "loader": {
            "name": "batches",
            "index": "b",
            "workers": {
              "param": "workers"
            },
            "prefetch": {
              "param": "prefetch"
            },
            "batches": {
              "param": "steps"
            },
            "ordered": true,
            "body": [
              {
                "loop": {
                  "index": "j",
                  "to": {
                    "param": "batch"
                  },
                  "body": [
                    {
                      "let": {
