            "sigma": 0.3,
            "min": {
              "mul": [
                {
                  "param": "sys_tokens_min"
                },
                {
                  "div": [
                    {
                      "param": "chunk_bytes"
                    },
                    {
                      "param": "chunk_tokens"
                    }
                  ]
                }
              ]
            },
            "max": {
              "mul": [
                {
                  "param": "sys_tokens_max"
                },
                {
                  "div": [
                    {
                      "param": "chunk_bytes"
                    },
                    {
                      "param": "chunk_tokens"
                    }
                  ]
                }
              ]
            }
          }
        },
        "seed": 1592646272,
        "chunk": {
          "param": "chunk_bytes"
        }
      }
    }
  },
  "namespaces": {
    "kv": {
      "pattern": "kv/{conv:016x}-{k:04}.pt",
      "fields": {
        "conv": "int",
        "k": "int"
      },
      "size": {
        "param": "chunk_bytes"
      },
      "seed": 1592646273
    }
  },
  "actors": {
