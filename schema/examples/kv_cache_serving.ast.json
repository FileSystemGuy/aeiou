{
  "ast": "0.4",
  "name": "kv_cache_serving",
  "doc": "One engine per actor; `concurrency` request slots; each request continues an earlier conversation or starts one.",
  "params": {
    "concurrency": {
      "default": 64,
      "unit": "count"
    },
    "warm": {
      "default": 2000,
      "unit": "count",
      "doc": "requests per slot before measurement (§9.5)"
    },
    "requests": {
      "default": 20000,
      "unit": "count"
    },
    "chunk_tokens": {
      "default": 256,
      "unit": "tokens"
    },
    "chunk_bytes": {
      "default": 33554432,
      "unit": "bytes",
      "doc": "128 KiB/token × 256 [config]; a file is exactly this, no header (traced)"
    },
    "sys_prompts": {
      "default": 50,
      "unit": "count"
    },
    "sys_tokens": {
      "default": 1500,
      "unit": "tokens",
      "doc": "median system prompt length [measure]"
    },
    "sys_tokens_min": {
      "default": 1,
      "unit": "tokens",
      "doc": "bounds of the system prompt length; equal bounds give every prompt that length"
    },
    "sys_tokens_max": {
      "default": 100000,
      "unit": "tokens"
    },
    "sys_pop": {
      "default": {
        "zipf": {
          "s": 1.1
        }
      },
      "doc": "[measure]"
    },
    "sys_local": {
      "default": true,
      "doc": "[config] the engine holds the system prompts in GPU memory and never reads their chunks (traced); false for an engine that starts cold beside a filled cache"
    },
    "reuse": {
      "default": {
        "mixture": [
          {
            "weight": 0.55,
            "dist": null
          },
          {
            "weight": 0.45,
            "dist": {
              "lognormal": {
                "median": 40,
                "sigma": 1.2,
                "min": 1
              }
            }
          }
        ]
      },
      "doc": "requests ago, or none for a new conversation [measure]"
    },
    "local": {
      "default": 8,
      "unit": "count",
      "doc": "[config: GPU KV memory] a conversation returning within this many requests is still in the engine and reads nothing"
    },
    "retain": {
      "default": 5000,
      "unit": "count",
      "doc": "older chunks are evicted [config: capacity]"
    },
    "turn_in": {
      "default": {
        "lognormal": {
          "median": 300,
          "sigma": 0.8
        }
      },
      "unit": "tokens"
    },
    "turn_out": {
      "default": {
        "lognormal": {
          "median": 250,
          "sigma": 0.6
        }
      },
      "unit": "tokens"
    },
    "prefill_per_token": {
      "default": 40000,
      "unit": "ns"
    },
    "decode_per_token": {
      "default": 12000000,
      "unit": "ns"
    }
  },
  "datasets": {
    "sysp": {
      "files": {
        "pattern": "kv/sys/{id:04}/blk_{k:04}",
        "count": {
          "param": "sys_prompts"
        },
        "size": {
          "lognormal": {
            "median": {
              "mul": [
                {
                  "param": "sys_tokens"
                },
                {
                  "div": [
                    {
                      "param": "chunk_bytes"
                    },
                    {
                      "param": "chunk_tokens"
                    }
                  ]
                }
              ]
