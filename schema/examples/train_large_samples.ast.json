    "sample_mean": {
      "default": 146800640,
      "unit": "bytes",
      "doc": "[measure]"
    },
    "sample_sd": {
      "default": 4194304,
      "unit": "bytes",
      "doc": "[measure]"
    }
  },
  "datasets": {
