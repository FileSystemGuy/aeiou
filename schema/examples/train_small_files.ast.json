{
  "ast": "0.6",
  "name": "train_small_files",
  "doc": "PyTorch DataLoader over an ImageFolder-style corpus; W workers, B files per batch, in-order delivery.",
  "params": {
    "batch": {
      "default": 32,
      "unit": "count"
    },
    "workers": {
      "default": 8,
      "unit": "count"
    },
    "prefetch": {
      "default": 2,
      "unit": "count"
    },
    "steps": {
      "default": 500,
      "unit": "count"
    },
    "sync_every": {
      "default": 500,
      "unit": "count",
      "doc": "1 for DDP; 500 keeps the brief's reference workload"
    },
    "step_time": {
      "default": 105000000,
      "unit": "ns",
      "doc": "[measure] GPU step time on the target accelerator"
    },
    "hdr_read": {
      "default": 1048576,
      "unit": "bytes",
      "doc": "Python BufferedReader request = st_blksize; 1 MiB on NFS with rsize 1 MiB (traced 2026-10-01)"
    },
    "enumerate": {
      "default": true,
      "doc": "the startup directory walk, as ImageFolder does it in every process (ABSTRACTS.md §9.8); on by default since 2026-10-02"
    },
    "files": {
      "default": 50000000,
      "unit": "count",
      "doc": "[config] corpus size; sized to the dataset rule (PROJECT_BRIEF.md §5)"
    }
  },
  "datasets": {
    "train": {
      "files": {
        "pattern": "train/{id div 1300:05}/img_{id:09}.jpg",
        "count": {
          "param": "files"
        },
        "size": {
          "lognormal": {
            "median": 112640,
            "sigma": 0.45
          }
        },
        "seed": 1592646266,
        "access": "map"
      }
    }
  },
  "actors": {
    "gpu": {
      "body": [
        {
          "cond": {
            "if": {
              "param": "enumerate"
            },
            "then": [
              {
                "phase": {
                  "name": "enumerate",
                  "body": [
                    {
                      "loop": {
                        "index": "d",
                        "to": {
                          "dirs": "train"
                        },
                        "body": [
                          {
                            "let": {
                              "name": "dh",
                              "value": {
                                "dir": {
                                  "dataset": "train",
                                  "id": {
                                    "index": "d"
                                  }
                                }
                              }
                            }
                          },
                          {
                            "stat": {
                              "file": {
                                "ref": "dh"
                              }
                            }
                          },
                          {
                            "open": {
                              "file": {
                                "ref": "dh"
                              },
                              "flags": [
                                "RDONLY",
                                "CLOEXEC",
                                "DIRECTORY"
                              ]
                            }
                          },
                          {
                            "fstat": {
                              "file": {
                                "ref": "dh"
                              }
                            }
                          },
                          {
                            "readdir": {
                              "dir": {
                                "ref": "dh"
                              },
                              "repeat": "until_end"
                            }
                          },
                          {
                            "close": {
                              "file": {
                                "ref": "dh"
                              }
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "loader": {
            "name": "batches",
            "index": "b",
            "workers": {
              "param": "workers"
            },
            "prefetch": {
              "param": "prefetch"
            },
            "batches": {
              "param": "steps"
            },
            "ordered": true,
            "body": [
              {
                "loop": {
                  "index": "j",
                  "to": {
                    "param": "batch"
                  },
                  "body": [
                    {
                      "let": {
                        "name": "f",
                        "value": {
                          "consume": "train"
                        }
                      }
                    },
                    {
                      "open": {
                        "file": {
                          "ref": "f"
                        },
                        "flags": [
                          "RDONLY",
                          "CLOEXEC"
                        ]
                      }
                    },
                    {
                      "fstat": {
                        "file": {
                          "ref": "f"
                        }
                      }
                    },
                    {
                      "ioctl": {
                        "file": {
                          "ref": "f"
                        },
                        "request": "TCGETS",
                        "expect": [
                          "ENOTTY"
                        ]
                      }
                    },
                    {
                      "lseek": {
                        "file": {
                          "ref": "f"
                        },
                        "offset": 0,
                        "whence": "CUR"
                      }
                    },
                    {
                      "lseek": {
                        "file": {
                          "ref": "f"
                        },
                        "offset": 0,
                        "whence": "SET"
                      }
                    },
                    {
                      "read": {
                        "file": {
                          "ref": "f"
                        },
                        "len": {
                          "param": "hdr_read"
                        },
                        "repeat": "until_eof"
                      }
                    },
                    {
                      "close": {
                        "file": {
                          "ref": "f"
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "phase": {
            "name": "train",
            "body": [
              {
                "loop": {
                  "index": "step",
                  "to": {
                    "param": "steps"
                  },
                  "body": [
                    {
                      "take": {
                        "channel": "batches"
                      }
                    },
                    {
                      "compute": {
                        "ns": {
                          "param": "step_time"
                        }
                      }
                    },
                    {
                      "cond": {
                        "if": {
                          "eq": [
                            {
                              "mod": [
                                {
                                  "index": "step"
                                },
                                {
                                  "param": "sync_every"
                                }
                              ]
                            },
                            0
                          ]
                        },
                        "then": [
                          {
                            "barrier": {
                              "scope": "global"
                            }
                          }
                        ]
                      }
                    }
                  ]
                }
              }
            ]
          }
        }
      ]
    }
  },
  "provenance": {
    "generator": {
      "script": "train_small_files.py",
      "sha256": "d7010b7d6d36a512362127d4eff03c4e5158bdeac1f9d49ff137401cb01cc6b1",
      "builder_version": "0.1.0",
      "git": "ddb845fffc77"
    },
    "python": "3.12.13",
    "lock": {
      "file": "uv.lock",
      "sha256": "f58ab2f23f8662236112836645f4d863a3a44858a5ea36281605f35ea08e77bd"
    },
    "built_twice_identical": true,
    "ast_sha256": "1d51b91e4782858173a837e792008a770d079a0d7544e36d95c9d8cf32f151e6"
  }
}
