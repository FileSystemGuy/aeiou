{
  "ast": "0.1",
  "name": "vdb_search_diskann",
  "doc": "Beam search over a sector-packed graph index: `hops` dependent rounds of `beam` concurrent 4 KiB reads per query.",
  "params": {
    "threads": {
      "default": 32,
      "unit": "count",
      "doc": "search threads per node (an actor is a search node)"
    },
    "queries": {
      "default": 100000,
      "unit": "count",
      "doc": "per thread; finite"
    },
    "beam": {
      "default": 4,
      "unit": "count"
    },
    "cached_hops": {
      "default": 2,
      "unit": "count",
      "doc": "rounds served from the node cache [measure]; documentation only"
    },
    "hops": {
      "default": {
        "empirical": {
          "values": [
            3,
            4,
            5,
            6,
            7,
            8
          ],
          "weights": [
            5,
            20,
            35,
            25,
            10,
            5
          ]
        }
      },
      "unit": "count",
      "doc": "[measure] rounds that reach storage: the trace's rounds minus cached_hops"
    },
    "hot": {
      "default": {
        "hotset": {
          "fraction": 0.01,
          "weight": 0.3
        }
      },
      "doc": "hub nodes [measure from trace]"
    },
    "rerank": {
      "default": 120000,
      "unit": "ns",
      "doc": "[measure]"
    },
    "sector": {
      "default": 4096,
      "unit": "bytes"
    }
  },
  "datasets": {
    "index": {
      "regions": {
        "file": "diskann/index.bin",
        "count": 200000000,
        "slot": {
          "param": "sector"
        },
        "size": {
          "const": {
            "param": "sector"
          }
        },
        "seed": 1592646269
      }
    }
  },
  "actors": {
    "gpu": {
      "body": [
        {
          "parallel": {
            "index": "th",
            "width": {
              "param": "threads"
            },
            "body": [
              {
                "let": {
                  "name": "f",
                  "value": {
                    "file": {
                      "dataset": "index",
                      "id": 0
                    }
                  }
                }
              },
              {
                "open": {
                  "file": {
                    "ref": "f"
                  },
                  "flags": [
                    "RDONLY",
                    "DIRECT"
                  ]
                }
              },
              {
                "loop": {
                  "index": "q",
                  "to": {
                    "param": "queries"
                  },
                  "body": [
                    {
                      "loop": {
                        "index": "hop",
                        "to": {
                          "draw": {
                            "param": "hops"
                          }
                        },
                        "body": [
                          {
                            "parallel": {
                              "index": "bm",
                              "width": {
                                "param": "beam"
                              },
                              "body": [
                                {
                                  "let": {
                                    "name": "s",
                                    "value": {
                                      "pick": {
                                        "dataset": "index",
                                        "dist": {
                                          "cond": {
                                            "if": {
                                              "lt": [
                                                {
                                                  "index": "hop"
                                                },
                                                1
                                              ]
                                            },
                                            "then": {
                                              "param": "hot"
                                            },
                                            "else": {
                                              "uniform": {
                                                "lo": 0,
                                                "hi": {
                                                  "count": "index"
                                                }
                                              }
                                            }
                                          }
                                        }
                                      }
                                    }
                                  }
                                },
                                {
                                  "read": {
                                    "file": {
                                      "ref": "f"
                                    },
                                    "len": {
                                      "param": "sector"
                                    },
                                    "offset": {
                                      "offset": {
                                        "ref": "s"
                                      }
                                    }
                                  }
                                }
                              ]
                            }
                          }
                        ]
                      }
                    },
                    {
                      "compute": {
                        "ns": {
                          "param": "rerank"
                        }
                      }
                    }
                  ]
                }
              },
              {
                "close": {
                  "file": {
                    "ref": "f"
                  }
                }
              }
            ]
          }
        }
      ]
    }
  },
  "provenance": {
    "generator": {
      "script": "vdb_search_diskann.py",
      "sha256": "5e359932a16fb1ef8c122048481636c63c080e07f536140433ce024ce62504bd",
      "builder_version": "0.1.0",
      "git": "b77a29eb053b"
    },
    "python": "3.12.13",
    "lock": {
      "file": "uv.lock",
      "sha256": "ddae2233f774d27319531008b14a67202c6e43fc1ecae1cbaa0bd5ffb2226395"
    },
    "built_twice_identical": true,
    "ast_sha256": "067244bc87a20af46f054bdbe6e37a1ddc314ba62b899e2ab609a76f306deeb0"
  }
}
