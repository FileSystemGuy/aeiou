          "weights": [
            1,
            135,
            536,
            269,
            47,
            9,
            2
          ]
        }
      },
      "unit": "count",
      "doc": "rounds of a query after the two near the entry points; measured on SIFT1M at search list 100, beam 4"
    },
    "entry": {
      "default": {
        "hotset": {
          "fraction": 2e-07,
          "weight": 1
        }
      },
      "doc": "[config] the entry points' sectors: medoids / sectors (one medoid per build shard; 40 here)"
    },
    "near": {
      "default": {
        "hotset": {
          "fraction": 1e-05,
          "weight": 1
        }
      },
      "doc": "[config] the sectors of the entry points' neighbours: about 0.8 * medoids * degree / sectors (661 distinct sectors for 13 medoids of degree 64, measured)"
    },
    "node_cache": {
      "default": 0,
      "unit": "count",
      "doc": "[config] sector reads that fill the node cache at load (about one per cached node); with a cache, queries skip the two rounds near the entry points"
    },
    "cache_batch": {
      "default": 8,
      "unit": "count",
      "doc": "requests per submit while the node cache loads (traced)"
    },
    "rerank": {
      "default": 500000,
      "unit": "ns",
      "doc": "CPU of one query; measured 0.5 ms of user time over 28 rounds, one host"
    },
    "sector": {
      "default": 4096,
      "unit": "bytes"
    },
    "nodes": {
      "default": 200000000,
      "unit": "count",
      "doc": "[config] sectors of the index (a sector holds per_sector graph nodes)"
    },
    "per_sector": {
      "default": 5,
      "unit": "count",
      "doc": "[config] graph nodes per sector: 4 KiB over (vector bytes + 4 + 4 * degree)"
    },
    "pq_code": {
      "default": 32,
      "unit": "bytes",
      "doc": "[config] bytes of one PQ-compressed vector, held in memory"
    },
    "stream": {
      "default": 8191,
      "unit": "bytes",
      "doc": "the first read of a C++ stream on a file (traced)"
    },
    "pq_read": {
      "default": 2147479552,
      "unit": "bytes",
      "doc": "the stream reads the rest of the PQ file in one call; Linux returns at most this much per read"
    }
